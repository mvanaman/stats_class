mydata$pid7 <- ordered(mydata$pid7, levels = c(1,2,3,4,5,6,7), labels = c("Strong Dem", "NV-Strong Dem", "Leans Dem", "Neither", "Leans Rep", "NV-Strong Rep", "Strong Rep"))
mydata$DemVsRep <- NA
mydata$DemVsRep[mydata$pid7=="Strong Dem"] <- 1
mydata$DemVsRep[mydata$pid7=="NV-Strong Dem"] <- 1
mydata$DemVsRep[mydata$pid7=="Leans Dem"] <- 1
mydata$DemVsRep[mydata$pid7=="Leans Rep"] <- 0
mydata$DemVsRep[mydata$pid7=="NV-Strong Rep"] <- 0
mydata$DemVsRep[mydata$pid7=="Strong Rep"] <- 0
mydata$DemVsRep <- factor(mydata$DemVsRep, levels = c(0,1), labels = c("Republican", "Democrat"), ordered=FALSE)
