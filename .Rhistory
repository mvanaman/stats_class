mu <- 50
sd <- 10
vec <- rnorm(5000000, m = mu, sd = sd)
ggplot(
tibble(vec = vec),
aes(x = vec)
) +
stat_function(
fun = function(x)
dnorm(x, mean = mu, sd = sd)
) +
geom_vline(xintercept = me)
ggplot(
tibble(vec = vec),
aes(x = vec)
) +
stat_function(
fun = function(x)
dnorm(x, mean = mu, sd = sd)
) +
geom_vline(xintercept = mu)
